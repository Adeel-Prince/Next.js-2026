# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# here add some more ignoring files:
# 📦 Block dependency allocations
node_modules/
package-lock.json

# 🛠️ Next.js Production Build Outputs & Local Compilation Caches
.next/
out/
build/

# 🔐 HIDE ALL ENVIRONMENT CREDENTIALS
.env
.env.local
.env.production
*.env
*.local

# IDE / System Clutter
.vscode/
.DS_Store
Thumbs.db
AGENTS.md
